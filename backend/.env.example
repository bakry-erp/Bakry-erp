# Render environment variables. Never commit real values or send them in chat.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
ADMIN_USERNAME=owner_admin_username
ADMIN_PASSWORD=use-a-long-unique-owner-password
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
# Origin only (no path): GitHub Pages sends https://bakry-erp.github.io
APP_ORIGIN=https://bakry-erp.github.io
NODE_ENV=production
PORT=3000
PG_POOL_MAX=5
# Keep strict certificate validation unless your database provider documents otherwise.
PGSSL_REJECT_UNAUTHORIZED=true
